{
  // ---------------------------------------------------------------- Todo Tree
  // Puts the lesson TODO markers in a tree in the activity bar. Markers look
  // like this inside a lesson .mdx file:
  //
  //     {/* TODO-BUG: what is wrong — what to do about it. [REVIEW §N] */}
  //
  // The tags are plain words on purpose: Todo Tree drops them straight into a
  // regex and documents no escaping, so a tag with brackets in it is a gamble.
  //
  // There is deliberately NO custom "todo-tree.regex.regex" here. The shipped
  // default already matches these markers (its `/\*` alternative matches the
  // `/*` inside `{/*`), and a custom regex is one more thing that can silently
  // match nothing.
  "todo-tree.general.tags": [
    "TODO-BUG",
    "TODO-BLOCKED",
    "TODO-ANSWERS",
    "TODO-CONVENTION",
    "TODO-MEDIA"
  ],

  // Most urgent first: red for things a student can hit, amber for things
  // waiting on a decision or a robot, quieter colours for the rest.
  "todo-tree.highlights.defaultHighlight": {
    "type": "text-and-comment",
    "foreground": "#ffffff",
    "opacity": 80,
    "gutterIcon": true
  },
  "todo-tree.highlights.customHighlight": {
    "TODO-BUG": {"background": "#c0392b", "icon": "bug", "iconColour": "#c0392b"},
    "TODO-BLOCKED": {"background": "#b9770e", "icon": "watch", "iconColour": "#b9770e"},
    "TODO-ANSWERS": {"background": "#7d3c98", "icon": "eye-closed", "iconColour": "#7d3c98"},
    "TODO-CONVENTION": {"background": "#2874a6", "icon": "checklist", "iconColour": "#2874a6"},
    "TODO-MEDIA": {"background": "#117864", "icon": "device-camera", "iconColour": "#117864"}
  },

  // Scan the whole repo (the default, but stated so an empty tree can't be
  // blamed on it), group by tag, and show counts.
  "todo-tree.tree.scanMode": "workspace",
  "todo-tree.tree.grouped": true,
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules/**",
    "**/build/**",
    "**/.docusaurus/**"
  ],

  // ------------------------------------------------------------------- Search
  // Keep generated output out of Cmd+Shift+F, so searching TODO- finds only the
  // real markers.
  "search.exclude": {
    "build": true,
    ".docusaurus": true,
    "node_modules": true,
    "src/data": true,
    "src/pages/checks": true
  },

  // ---------------------------------------------------------------------- MDX
  "files.associations": {"*.mdx": "mdx"},
  "[mdx]": {"editor.wordWrap": "on"}
}
